// METHOD 1: SUM FORMULA 
class Solution {
    public int missingNumber(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int exp = n * (n+1)/2;
        int sum =0;
        for(int num: nums){
        sum += num;
        }
         return exp - sum;
    }
   
}

// METHOD 2: XOR OPTIMAL SOLUTION
class Solution {
    public int missingNumber(int[] nums) {
    int xor = nums.length;
    for(int i=0;i<nums.length;i++){
        xor ^= i;
        xor ^= nums[i];
    }
    return xor;
    }
   
}
