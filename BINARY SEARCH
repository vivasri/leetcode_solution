class Solution {

    public int[] searchRange(int[] nums, int target) {
        int first = findFirst(nums, target);
        int last = findLast(nums, target);

        return new int[]{first, last};
    }

    public int findFirst(int[] nums, int target) {
        int l = 0;
        int h = nums.length - 1;
        int ans = -1;

        while (l <= h) {
            int mid = (l + h) / 2;

            if (target == nums[mid]) {
                ans = mid;
                h = mid - 1;   // search left
            }
            else if (nums[mid] < target) {
                l = mid + 1;
            }
            else {
                h = mid - 1;
            }
        }

        return ans;
    }

    public int findLast(int[] nums, int target) {
        int l = 0;
        int h = nums.length - 1;
        int ans = -1;

        while (l <= h) {
            int mid = (l + h) / 2;

            if (target == nums[mid]) {
                ans = mid;
                l = mid + 1;   // search right
            }
            else if (nums[mid] < target) {
                l = mid + 1;
            }
            else {
                h = mid - 1;
            }
        }

        return ans;
    }
}
